use.miden::account
use.miden::contracts::wallets::basic->wallet
use.miden::note
use.miden::tx
use.std::math::u64
use.std::sys

# CONSTANTS
# =================================================================================================

const.MAX_U32=0x0000000100000000
const.BASE=1000 # 1e3
const.DIV=1000 # 1e3

# Memory Addresses for AMM calculations
const.POOL_X = 0x0040
const.POOL_Y = 0x0041
const.DX_IN = 0x0042
const.DY_OUT = 0x0043

# Run time u64 memory addresses
const.DX_MUL_Y_BASE = 100
const.DX_PLUS_Y = 104

# Memory Addresses
const.ASSET_IN=200
const.ASSET_OUT=212

# ERRORS
const.OVERFLOW="value larger than 32 bits"

const.BALANCES_SLOT=0

# AMM CALCULATION
# =================================================================================================

#! Calculates the amount of asset Y to return given input of asset X
#! Formula: dy = (dx * y) / (dx + x)
#!
#! Assumes input values are base 1e3
#! Returns dy as fixed point 1e3
#!
#! Inputs: [x, y, dx]
#! Outputs: [dy]
export.get_amount_y_out
    mem_store.POOL_X
    mem_store.POOL_Y
    mem_store.DX_IN
    # => []

    mem_load.DX_IN
    u32split
    # => [dx_high, dx_low]

    mem_load.POOL_Y
    u32split
    # => [y_high, y_low, dx_high, dx_low]

    exec.u64::wrapping_mul
    # => [dxy_high, dyx_low]

    push.0.0
    # => [0, 0, dxyb_high, dyxb_low]

    mem_storew.DX_MUL_Y_BASE dropw
    # => []

    mem_load.DX_IN
    u32split
    # => [dx_high, dx_low]

    mem_load.POOL_Y
    u32split
    # => [dx_high, dx_low, y_high, y_low]

    exec.u64::wrapping_add
    # => [sum_dx_y_high, sum_dx_y_low]

    padw mem_loadw.DX_MUL_Y_BASE drop drop
    # => [dxyb_high, dyxb_low, sum_dx_y_high, sum_dx_y_low]

    movup.3 movup.3
    # => [sum_dx_y_high, sum_dx_y_low, dxyb_high, dyxb_low]

    exec.u64::div
    # => [dy_base_high, dy_base_low]

    eq.0 assert.err=OVERFLOW

    exec.sys::truncate_stack
end

# procedure to deploy network account onchain
export.deploy_contract
    push.0.0.0.0
    # => [KEY]

    push.BALANCES_SLOT
    # => [slot, KEY]

    exec.account::get_map_item
    # => [VALUE]

    padw
    # => [EMPTY_WORD, VALUE]

    assert_eqw
    # => []

    push.1.1.1.1
    # => [VALUE]

    padw
    # => [KEY, VALUE]

    push.BALANCES_SLOT
    # => [slot]

    exec.account::set_map_item
    # => [OLD_MAP_ROOT, OLD_MAP_VALUE]

    dropw dropw
    # => []
end

# => [ASSET_IN, ASSET_OUT]
export.swap
    mem_storew.ASSET_IN

    movup.2 drop movup.2 drop
    # => [asset_in_prefix, asset_in_suffix, ASSET_OUT]

    ### ____ AMM COMPUTATION ____

    # get balance faucet_id_in
    call.account::get_balance
    # => [pool_x_balance, ASSET_OUT]

    push.333 debug.stack drop
    
    mem_store.POOL_X
    # => [asset_in_prefix, asset_in_suffix, ASSET_OUT]

    push.0 movdn.2 push.0 movdn.2

    mem_storew.ASSET_OUT
    # => [asset_out_prefix, asset_out_suffix, OUPUT_NOTE]

    push.444 debug.stack drop swap

    # get balance faucet_id_out
    call.account::get_balance
    # => [asset_out_balance]

    push.555 debug.stack drop

    mem_store.POOL_Y
    # => [OUPUT_NOTE]

    mem_loadw.ASSET_IN
    # => [ASSET_IN, OUPUT_NOTE]

    drop drop drop
    # => [dx, OUPUT_NOTE]

    dup mem_store.DX_IN

    mem_load.POOL_Y
    mem_load.POOL_X
    # => [x, y, dx, OUTPUT_NOTE]

    exec.get_amount_y_out
    # => [dy]

    mem_store.DY_OUT
    # => []

    mem_loadw.ASSET_IN

    call.wallet::receive_asset
    # => []

    push.0 exec.note::get_inputs drop

    mem_loadw.4 padw mem_loadw.8
    # => [tag, aux, note_type, execution_hint, RECIPIENT]

    call.tx::create_note
    # => [note_idx]

    mem_loadw.ASSET_OUT

    mem_load.DY_OUT

    movdn.3
    # => [ASSET_Y_OUT]

    call.wallet::move_asset_to_note
    # => [ASSET, note_idx]

    dropw dropw
end
